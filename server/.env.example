DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negosyo_quest?schema=public
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=facilitator
ADMIN_PASSWORD=replace-with-a-strong-password
PORT=4000
NODE_ENV=development
# Railway has one reverse proxy. Use 0 for direct local connections.
TRUST_PROXY=0
# Optional, separate disposable PostgreSQL database for integration tests:
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negosyo_quest_test?schema=public
